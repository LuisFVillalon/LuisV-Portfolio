# Copy to .env.local for local development. Never commit real values.

# ── Contact form (/api/contact) and the assistant's weekly digest ──
RESEND_API_KEY=
FROM_EMAIL=          # sender, verified in Resend
TO_EMAIL=            # where messages and the weekly digest go

# ── GitHub stats section (optional) ──
GITHUB_USERNAME=
GITHUB_TOKEN=        # optional; also raises the assistant indexer's GitHub rate limit

# ── AI assistant ("Ask AI"). Leave these empty and the chat stays hidden. ──
ANTHROPIC_API_KEY=           # Claude Sonnet 5.5 answers
VOYAGE_API_KEY=              # embeddings + rerank-2.5
UPSTASH_VECTOR_REST_URL=     # hybrid index: dense 1024 dims, cosine, sparse enabled (custom/BYO vectors)
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_REDIS_REST_URL=      # counters, monthly spend, saved chats (KV_REST_API_URL also works)
UPSTASH_REDIS_REST_TOKEN=    # (KV_REST_API_TOKEN also works)
CRON_SECRET=                 # protects /api/assistant/reindex and /api/assistant/digest

# Private content: never committed (the repo is public). Paste the Markdown, or "base64:<...>".
# Locally you can instead put the files in .private/assistant-facts.md and .private/linkedin-profile.md.
ASSISTANT_FACTS=
ASSISTANT_LINKEDIN_PROFILE=

# Optional tuning
# ASSISTANT_DISABLED=1            # hide the assistant without removing keys
# ASSISTANT_RERANK_MIN_SCORE=0.3  # rerank-2.5 relevance cutoff for "I don't know"
# ASSISTANT_HASH_SALT=            # salt for hashed visitor ids (defaults to CRON_SECRET)
# VOYAGE_EMBED_MODEL=voyage-4     # changing model or dimension means re-embedding everything
# VOYAGE_EMBED_DIMENSION=1024
# VOYAGE_RERANK_MODEL=rerank-2.5
